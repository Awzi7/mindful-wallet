{
  "expo": {
    "name": "Mindful Wallet",
    "slug": "MindfulWallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mindfulwallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindfulwallet.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mindfulwallet.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF3EA",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#221F1C"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mindful Wallet uses your location only while the app is open, to detect when you're near a place you've marked as a spending hotspot and warn you ahead of time.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mindful Wallet uses Face ID to keep your spending data private if you enable the app lock in Settings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2E9E8F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf1aa859-55ad-4f6e-bf1d-b823c7ad20ac"
      },
      "revenueCatApiKeyIos": "YOUR_REVENUECAT_IOS_PUBLIC_SDK_KEY",
      "revenueCatApiKeyAndroid": "YOUR_REVENUECAT_ANDROID_PUBLIC_SDK_KEY",
      "revenueCatEntitlementId": "premium"
    }
  }
}
